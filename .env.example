# ---------------------------------------------------------------------------
# AEM Testautomatisierung - Umgebungsvariablen
# Kopiere diese Datei nach `.env` und trage die Werte ein.
# Die `.env` darf NICHT ins Repository eingecheckt werden (siehe .gitignore).
# ---------------------------------------------------------------------------

# Basis-URL der AEM-Author-Instanz (ohne abschließenden Slash).
# TEST:      https://aem-author-test.ws.fraunhofer.de
# DEV:       https://aem-author-dev.ws.fraunhofer.de
# ALT (Ref): URL der alten AEM-Version als Vergleichsreferenz
AEM_BASE_URL=https://aem-author-test.ws.fraunhofer.de

# Logischer Umgebungsname. Steuert die Trennung der Screenshot-Baselines.
# Erlaubte Werte (Konvention): test | dev | legacy
AEM_ENV=test

# Zugangsdaten für den AEM-Author-Login (lokaler Admin-Login).
AEM_USER=admin
AEM_PASSWORD=

# Pfad der "Spielwiese", unter der Testseiten angelegt/gelöscht werden.
# WICHTIG: Schreiboperationen sind ausschließlich unterhalb dieses Pfads erlaubt.
AEM_PLAYGROUND_PATH=/content/fhgtest
# Schreibziel des LDAP-Visitenkartenimports (Feld erzwingt /content/businesscards/...).
# AEM_BUSINESSCARD_PLAYGROUND_PATH=/content/businesscards/fhgtest
# DAM-Spielwiese für den Asset-Test (eigener Testordner darin, Freigabe 18.11.2026).
# AEM_DAM_PLAYGROUND_PATH=/content/dam/fhgtest

# Optional: Nur-lesender Pfad (Zentralverwaltung). Derzeit von keinem Test genutzt.
AEM_READONLY_PATH=/content/zv

# Basis-URL der AEM-Publish-Instanz (ohne Slash) für die visuelle Regression.
# Wird explizit gesetzt. Fehlt sie, versucht der Code eine Ableitung aus
# AEM_BASE_URL (author -> publish1); gelingt das nicht, werden Publish-Tests
# übersprungen.
# DEV: https://aem-publish1-dev.ws.fraunhofer.de
# TEST: https://aem-publish1-test.ws.fraunhofer.de
AEM_PUBLISH_URL=https://aem-publish1-dev.ws.fraunhofer.de

# Optional: Wurzelpfad der Komponenten-Beispielseiten (/content/samples).
# Default deckt die priorisierten Komponenten ab. Gilt gegen DEV und TEST.
AEM_SAMPLES_ROOT=/content/samples/de/components
# Optional (Defaults vorhanden):
# AEM_TEST_COMPONENT=Verweis
# AEM_DOWNLOAD_COMPONENT=Herunterladen
# AEM_RESTORE_TREE_PAGE=/de
# ERROR_PAGE_PATH=/content/samples/de/qa-seite-gibt-es-nicht
# LDAP_SEARCH_QUERY=Max
