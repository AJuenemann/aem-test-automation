{
  "name": "aem-test-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Testautomatisierung MVP (AEM-Basisfunktionen) für die Fraunhofer AEM 6.5 LTS Migration",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:basics": "playwright test tests/basics --grep @level1",
    "test:components": "playwright test tests/components/dialog.spec.ts tests/components/visual-publish.spec.ts tests/components/component-authoring.spec.ts tests/basics/visual-regression.spec.ts",
    "test:integration": "playwright test tests/integration",
    "test:regression": "playwright test tests/regression",
    "capture-dialogs": "CAPTURE_DIALOGS=1 playwright test tests/components/dialog-capture.spec.ts",
    "capture-references": "CAPTURE_REFERENCES=1 playwright test tests/regression/references-capture.spec.ts",
    "update-snapshots": "playwright test --update-snapshots=all",
    "baseline:visual": "playwright test tests/basics/visual-regression.spec.ts tests/components/visual-publish.spec.ts tests/regression/error-pages.spec.ts --update-snapshots=all",
    "baseline:firefox": "FIREFOX_BASELINES=1 SMOKE_GATE=0 playwright test --project=setup --project=firefox --update-snapshots=missing",
    "report": "playwright show-report",
    "cockpit": "tsx cockpit/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
